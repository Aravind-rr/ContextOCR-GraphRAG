APP_ENV=development
DATA_DIR=./data
DATABASE_URL=sqlite:///./backend/ocr_graphrag.db
MAX_UPLOAD_MB=25
CONFIDENCE_THRESHOLD=0.90
CANDIDATE_COUNT=5
OCR_ENGINE=paddle
PADDLE_LANG=en
PADDLE_OCR_VERSION=PP-OCRv5
PADDLE_DEVICE=cpu
EMBEDDING_MODEL=./models/bge-m3-fp16
RETRIEVAL_TOP_K=3
CHUNK_SIZE=80
DOC_LAYOUT_MODEL_PATH=./models/doclayout-yolo/doclayout_yolo_docstructbench_imgsz1024.pt
DOC_LAYOUT_DEVICE=cpu
DOC_LAYOUT_CONFIDENCE=0.20
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
SLM_MODEL_PATH=./models/qwen2.5-3b-instruct-gguf/qwen2.5-3b-instruct-q4_k_m.gguf
LLAMA_SERVER_EXECUTABLE=./tools/llama.cpp/bin/llama-server.exe
LLAMA_SERVER_URL=http://127.0.0.1:8091
LLAMA_SERVER_API_KEY=
SLM_GPU_LAYERS=99
SLM_CONTEXT_SIZE=4096
SLM_MAX_NEW_TOKENS=120
VITE_API_URL=http://localhost:8000
